# Which LLM powers entity/relationship extraction: "anthropic", "groq", or "llama"
LLM_PROVIDER=llama

# Needed if LLM_PROVIDER=anthropic — get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Needed if LLM_PROVIDER=groq — get a free-tier key at https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Needed if LLM_PROVIDER=llama — use an OpenAI-compatible LLAMA deployment
LLAMA_API_KEY=
LLAMA_MODEL=llama-3.1-70b-instruct
LLAMA_BASE_URL=https://api.llama.com/v1

PORT=5000
